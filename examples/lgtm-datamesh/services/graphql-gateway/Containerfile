# graphql-gateway Containerfile — UBI 10 multi-stage build, Python 3.14 (CAP-005).
# Builder runs as root (writes /opt/venv); runtime is non-root USER 1001:0.
# Copies the committed gRPC client stubs (gen/) for the inventory call (CAP-013).

FROM registry.access.redhat.com/ubi10/python-314-minimal:10.2-1791464217 AS builder
USER 0
WORKDIR /build
RUN pip install --no-cache-dir "poetry==1.8.4" "poetry-plugin-export==1.8.0"
COPY pyproject.toml poetry.lock* ./
RUN poetry export --without-hashes --only main -f requirements.txt -o requirements.txt \
    && python -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir -r requirements.txt

# r29c: OpenTelemetry auto-instrumentation. Installed with pip into the venv (not
# poetry) so we don't regenerate poetry.lock for an observability concern.
# opentelemetry-bootstrap inspects the installed libraries (FastAPI, httpx, grpc)
# and pulls the matching opentelemetry-instrumentation-* packages;
# opentelemetry-instrument (wrapping the CMD below) activates them at startup.
# Spans export to Tempo over OTLP — endpoint/sampling come from env on the
# Deployment, so this image traces only when those are set.
# PIP_CONSTRAINT holds every package already in the venv (installed from
# poetry.lock above) at its locked version, so the OpenTelemetry install cannot
# move one; without it pip upgraded protobuf past the project's <6 pin.
RUN /opt/venv/bin/pip freeze > /build/constraints.txt \
    && PIP_CONSTRAINT=/build/constraints.txt /opt/venv/bin/pip install --no-cache-dir \
        "opentelemetry-distro==0.66b1" \
        "opentelemetry-exporter-otlp==1.45.1" \
    && PIP_CONSTRAINT=/build/constraints.txt /opt/venv/bin/opentelemetry-bootstrap -a install

FROM registry.access.redhat.com/ubi10/python-314-minimal:10.2-1791464217 AS runtime
WORKDIR /opt/app-root/src
COPY --from=builder --chown=1001:0 /opt/venv /opt/venv
COPY --chown=1001:0 app/ ./app/
# Committed gRPC client stubs (capstone.inventory.v1). app/ adds gen/ to sys.path.
COPY --chown=1001:0 gen/ ./gen/
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1
# gRPC clients resolve names with the system resolver (getaddrinfo), like every
# other library here. gRPC's bundled c-ares resolver took ~3 s for short
# Service names on minikube, which equals the 3 s CheckStock deadline (see
# onboarding/LESSONS-LEARNED.md).
ENV GRPC_DNS_RESOLVER=native

USER 1001:0
EXPOSE 8080
# r29c: opentelemetry-instrument activates the auto-instrumentations installed
# above and wraps the ASGI app, then execs uvicorn. A no-op if no OTEL_* env is
# set (it just runs uvicorn), so the image is safe to run untraced too.
CMD ["opentelemetry-instrument", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080"]
